{
  "name": "ops-patent-search",
  "version": "1.1.2",
  "description": "Unofficial MCP server for exploring patents via the EPO Open Patent Services (OPS) API. Not affiliated with the EPO. An exploratory tool for Claude Desktop and other MCP clients — not a substitute for specialised patent search platforms.",
  "main": "dist/index.js",
  "bin": {
    "ops-patent-search": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle": "node build-bundle.mjs",
    "prepublishOnly": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx tests/integration.ts",
    "test:unit": "node --import tsx --test tests/unit/*.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:scenarios": "node --import tsx integration_tests/run-all.ts",
    "prepack": "npm run build",
    "check": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "release:check": "npm run build && npm run bundle && node scripts/check-release.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "patents",
    "epo",
    "patent-search",
    "intellectual-property",
    "open-patent-services",
    "claude",
    "ai-tools"
  ],
  "author": "Navis Bio",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navisbio/OPS-patent-search-mcp.git"
  },
  "homepage": "https://github.com/navisbio/OPS-patent-search-mcp#readme",
  "bugs": {
    "url": "https://github.com/navisbio/OPS-patent-search-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
