# Allowlist: ignore everything, then re-include what the bundle ships.
# A blocklist let local-only files (.beads/, .githooks/*.local, scratch
# scripts in server/) slip into the archive.
/*

!/manifest.json
!/package.json
!/README.md
!/LICENSE

# server/bundle.cjs has everything (MCP SDK and zod included)
!/server
/server/*
!/server/bundle.cjs

# Workflow skills and commands
!/skills
!/commands
